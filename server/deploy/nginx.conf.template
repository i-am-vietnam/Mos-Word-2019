# Managed by MOS Word deployment.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @SERVER_IP@;
    ssl_certificate /etc/mosword/tls/server.crt;
    ssl_certificate_key /etc/mosword/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 512k;

    location ~* ^/Admin(?:/|$) {
@ADMIN_ALLOW_LIST@
        proxy_pass http://127.0.0.1:5000;
        include /etc/nginx/mosword-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
        include /etc/nginx/mosword-proxy.conf;
    }
}
