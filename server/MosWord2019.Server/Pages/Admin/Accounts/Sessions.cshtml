@page "{id:guid}"
@model MosWord2019.Server.Pages.Admin.Accounts.SessionsModel
@{ ViewData["Title"] = "Phiên của học viên"; }
<h1>Phiên đăng nhập — @Model.Username</h1><p>Mã tài khoản: @Model.AccountId</p>
<div class="actions"><a asp-page="Index">Học viên</a><a asp-page="/Admin/Results/Index" asp-route-accountId="@Model.AccountId">Kết quả tài khoản</a></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Mã phiên</th><th>Chế độ</th><th>Bắt đầu (giờ VN)</th><th>Liên hệ cuối (giờ VN)</th><th>Kết thúc (giờ VN)</th><th>Lý do</th><th>Mã máy rút gọn</th></tr></thead><tbody>
@foreach (var session in Model.Sessions) { <tr><td><code>@session.Id</code></td><td>@AdminDisplay.Mode(session.Mode)</td><td>@AdminDisplay.Time(session.StartedAt)</td><td>@AdminDisplay.Time(session.LastHeartbeatAt)</td><td>@AdminDisplay.Time(session.EndedAt)</td><td>@AdminDisplay.Reason(session.EndReason)</td><td><code>@session.MachinePrefix</code></td></tr> }
@if (Model.Sessions.Count == 0) { <tr><td colspan="7" class="empty">Chưa có phiên đăng nhập.</td></tr> }
</tbody></table></div>
<div class="pagination-bar"><span>Trang @Model.PageNumber · 50 phiên mỗi trang</span><div class="actions">
@if (Model.PageNumber > 1) { <a asp-route-id="@Model.AccountId" asp-route-pageNumber="@(Model.PageNumber - 1)">Trước</a> }
@if (Model.HasNext) { <a asp-route-id="@Model.AccountId" asp-route-pageNumber="@(Model.PageNumber + 1)">Tiếp</a> }
</div></div>
