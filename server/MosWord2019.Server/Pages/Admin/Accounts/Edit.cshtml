@page "{id:guid}"
@model MosWord2019.Server.Pages.Admin.Accounts.EditModel
@{ ViewData["Title"] = "Sửa học viên"; }
<h1>Sửa học viên — @Model.Username</h1>
<div class="actions mb-3"><a asp-page="Index">← Danh sách học viên</a><a asp-page="Sessions" asp-route-id="@RouteData.Values["id"]">Phiên đăng nhập</a><a asp-page="/Admin/Results/Index" asp-route-accountId="@RouteData.Values["id"]">Kết quả thi</a></div>
<form method="post" class="panel form-panel"><div asp-validation-summary="All" role="alert"></div>
<p>Đã dùng <strong>@Model.Used / @Model.CurrentMaxUses lượt</strong>.</p>
<p id="uses"><label class="form-label" asp-for="MaxUses">Đặt số lượt tối đa</label><input class="form-control" asp-for="MaxUses" min="@Model.Used" /><span class="hint">Để trống để giữ nguyên. Không được thấp hơn số lượt đã dùng.</span></p>
<p><label class="form-label" asp-for="AddUses">Cấp thêm lượt</label><input class="form-control" asp-for="AddUses" min="0" /><span class="hint">Cộng vào số lượt tối đa hiện tại, hoặc số tối đa vừa nhập.</span></p>
<p><label class="form-label" asp-for="ExpiresUtc">Hạn sử dụng (giờ VN)</label><input class="form-control" asp-for="ExpiresUtc" type="datetime-local" /><span class="hint">Để trống để bỏ giới hạn ngày sử dụng.</span></p>
<p id="lock" class="form-check"><input class="form-check-input" asp-for="Locked" /><label class="form-check-label" asp-for="Locked">Khóa tài khoản</label></p>
<p id="password"><label class="form-label" asp-for="NewPassword">Đặt lại mật khẩu</label><input class="form-control" type="password" name="NewPassword" id="NewPassword" autocomplete="new-password" minlength="12" maxlength="128" /><span class="hint">Để trống để giữ nguyên; mật khẩu mới cần 12–128 ký tự. Đặt lại sẽ thu hồi thông tin đăng nhập cũ và xóa khóa đăng nhập tạm.</span></p>
<button class="btn btn-primary" type="submit">Lưu thay đổi</button></form>
