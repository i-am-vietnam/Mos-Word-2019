@page
@model MosWord2019.Server.Pages.Admin.Results.IndexModel
@{ ViewData["Title"] = "Kết quả thi"; }
<h1>Kết quả thi@(Model.Username == null ? "" : " — " + Model.Username)</h1>
<form method="get" class="panel filters"><input type="hidden" asp-for="AccountId" />
<div><label class="form-label" asp-for="Account">Tài khoản</label><input class="form-control" asp-for="Account" maxlength="64" /></div>
<div><label class="form-label" asp-for="FromDate">Từ ngày (giờ VN)</label><input class="form-control" asp-for="FromDate" type="date" /></div>
<div><label class="form-label" asp-for="ToDate">Đến ngày (giờ VN)</label><input class="form-control" asp-for="ToDate" type="date" /></div>
<div><label class="form-label" asp-for="Verdict">Kết quả</label><select class="form-select" asp-for="Verdict"><option value="">Tất cả</option><option value="passed">Đạt</option><option value="practice">Cần Luyện Tập thêm</option></select></div>
<div><label class="form-label" asp-for="Flag">Cờ cần xem xét</label><select class="form-select" asp-for="Flag"><option value="">Tất cả</option><option value="any">Có cờ</option><option value="TimingInconsistent">Thời gian không nhất quán</option><option value="ClockRollbackDetected">Đồng hồ máy lùi</option></select></div>
<button class="btn btn-primary" type="submit">Lọc</button><a class="btn btn-outline-secondary" asp-page="Index">Xóa bộ lọc</a></form>
<p class="hint">Ngày kết thúc gồm cả ngày theo giờ Việt Nam. Điểm do máy chủ tính lại; các cờ không tự thay đổi điểm hoặc kết quả.</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Ngày nhận (giờ VN)</th><th>Tài khoản</th><th>Điểm / 1000</th><th>Kết quả</th><th>Cờ</th><th></th></tr></thead><tbody>
@foreach (var result in Model.Results)
{
<tr><td>@AdminDisplay.Time(result.ReceivedAt)</td><td><a asp-page="Index" asp-route-accountId="@result.AccountId">@result.Username</a></td><td class="score">@result.Score / 1000</td><td><span class="badge @(result.Passed ? "text-bg-success" : "badge-practice")">@(result.Passed ? "Đạt" : "Cần Luyện Tập thêm")</span></td><td>@foreach (var flag in AdminDisplay.Flags(result.FlagsJson)) { <span class="badge flag" title="@AdminDisplay.FlagDescription(flag)" data-code="@flag">@AdminDisplay.Flag(flag)</span> }</td><td><a asp-page="Details" asp-route-id="@result.Id">Chi tiết</a></td></tr>
}
@if (Model.Results.Count == 0) { <tr><td colspan="6" class="empty">Không có kết quả phù hợp.</td></tr> }
</tbody></table></div>
<div class="pagination-bar"><span>Trang @Model.PageNumber · 50 kết quả mỗi trang</span><div class="actions">
@if (Model.PageNumber > 1) { <a asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-accountId="@Model.AccountId" asp-route-account="@Model.Account" asp-route-verdict="@Model.Verdict" asp-route-flag="@Model.Flag" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Trước</a> }
@if (Model.HasNext) { <a asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-accountId="@Model.AccountId" asp-route-account="@Model.Account" asp-route-verdict="@Model.Verdict" asp-route-flag="@Model.Flag" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Tiếp</a> }
</div></div>
