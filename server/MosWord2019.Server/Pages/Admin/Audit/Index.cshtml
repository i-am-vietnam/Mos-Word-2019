@page
@model MosWord2019.Server.Pages.Admin.Audit.IndexModel
@{ ViewData["Title"] = "Nhật ký"; }
<h1>Nhật ký hoạt động</h1>
<form method="get" class="panel filters"><div><label class="form-label" asp-for="Account">Tài khoản</label><input class="form-control" asp-for="Account" maxlength="64" /></div><div><label class="form-label" asp-for="ActionFilter">Hành động</label><select class="form-select" asp-for="ActionFilter"><option value="">Tất cả</option>@foreach (var code in new[] { "AdminBootstrapped", "LearnerCreated", "LearnerUpdated", "LearnerLogin", "LoginFailed", "AccountTemporarilyLocked", "SessionModeSelected", "SessionResumed", "SessionEnded", "PackageDownloaded", "PackagesImported", "ExamDefinitionConfirmed", "ResultAccepted", "ResultUploadConflict", "ResultClockRollback", "TestingTimingFlagged" }) { <option value="@code">@AdminDisplay.Action(code)</option> }</select></div><button class="btn btn-primary" type="submit">Lọc</button></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Thời gian (giờ VN)</th><th>Tài khoản</th><th>Hành động</th></tr></thead><tbody>
@foreach (var entry in Model.Entries) { <tr><td>@AdminDisplay.Time(entry.CreatedAt)</td><td>@(entry.Username ?? "Hệ thống / chưa xác định")</td><td><span title="@entry.Action">@AdminDisplay.Action(entry.Action)</span></td></tr> }
@if (Model.Entries.Count == 0) { <tr><td colspan="3" class="empty">Không có nhật ký phù hợp.</td></tr> }
</tbody></table></div>
<div class="pagination-bar"><span>Trang @Model.PageNumber · 50 sự kiện mỗi trang</span><div class="actions">
@if (Model.PageNumber > 1) { <a asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-account="@Model.Account" asp-route-actionFilter="@Model.ActionFilter">Trước</a> }
@if (Model.HasNext) { <a asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-account="@Model.Account" asp-route-actionFilter="@Model.ActionFilter">Tiếp</a> }
</div></div>
