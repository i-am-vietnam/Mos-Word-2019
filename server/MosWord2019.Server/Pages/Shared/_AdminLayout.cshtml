<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — MOS Word 2019</title>
    <link rel="stylesheet" href="~/vendor/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
<header class="admin-header"><div class="container-fluid px-lg-4">
    <a class="brand" asp-page="/Admin/Index">MOS Word 2019 <span>Quản trị</span></a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="admin-nav" aria-label="Điều hướng quản trị">
            <a asp-page="/Admin/Index">Tổng quan</a><a asp-page="/Admin/Accounts/Index">Học viên</a>
            <a asp-page="/Admin/Results/Index">Kết quả thi</a><a asp-page="/Admin/Sessions/Index">Phiên đăng nhập</a>
            <a asp-page="/Admin/Audit/Index">Nhật ký</a>
            <form method="post" asp-page="/Admin/Logout"><button class="nav-logout" type="submit">Đăng xuất</button></form>
        </nav>
    }
</div></header>
<main class="container-fluid px-lg-4 py-4">@RenderBody()</main>
<footer class="container-fluid px-lg-4 pb-4 text-secondary small">MOS Word 2019 · Thời gian hiển thị theo giờ Việt Nam (UTC+7).</footer>
</body></html>
